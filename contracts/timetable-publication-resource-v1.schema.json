{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tubeboard.co.uk/contracts/timetable-publication-resource-v1.schema.json",
  "title": "TubeBoard reviewed timetable proof resource v1",
  "$comment": "Five-field metadata transport only. Consumers additionally enforce exact canonical wrapper bytes, strict base64/hash/decoded128KiB bound, embedded official SHA, full schema1 model/calendar/parity/current source admission. JSON Schema does not prove those semantics or revision ordering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationSHA256",
    "proofRevision",
    "proofBodySHA256",
    "proofBodyBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publicationSHA256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "proofBodySHA256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofBodyBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 174764,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64",
      "contentMediaType": "application/json"
    }
  }
}
