{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tubeboard.co.uk/contracts/live-activity-registration-v2.schema.json",
  "title": "TubeBoard station-board-v2 Live Activity registration",
  "type": "object",
  "additionalProperties": false,
  "x-tubeboard-contract-version": 2,
  "required": [
    "installID",
    "activityID",
    "stationID",
    "lineID",
    "pushTokenHex",
    "tokenUpdatedAt",
    "appBundleID",
    "appVersion",
    "buildNumber",
    "environment",
    "contentStateContract"
  ],
  "properties": {
    "installID": {
      "type": "string",
      "minLength": 1
    },
    "activityID": {
      "type": "string",
      "minLength": 1
    },
    "stationID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,80}$"
    },
    "lineID": {
      "enum": [
        "bakerloo",
        "central",
        "circle",
        "district",
        "hammersmith-city",
        "jubilee",
        "metropolitan",
        "northern",
        "piccadilly",
        "victoria",
        "waterloo-city",
        "elizabeth",
        "liberty",
        "lioness",
        "mildmay",
        "suffragette",
        "weaver",
        "windrush",
        "dlr"
      ]
    },
    "selectionMode": {
      "enum": [
        "platform",
        "allPlatforms"
      ]
    },
    "platformID": {
      "type": [
        "string",
        "null"
      ]
    },
    "platformHeading": {
      "type": [
        "string",
        "null"
      ]
    },
    "platformLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "platformDirection": {
      "type": [
        "string",
        "null"
      ]
    },
    "activityStartedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "activityEndsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pushTokenHex": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{32,512}$"
    },
    "tokenUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appBundleID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "appVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildNumber": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "production",
        "sandbox"
      ]
    },
    "contentStateContract": {
      "const": "station-board-v2"
    },
    "plannedPresentationVersion": {
      "type": "integer",
      "const": 2
    },
    "plannedContextSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stationID",
        "lineID",
        "contexts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "stationID": {
          "type": "string"
        },
        "lineID": {
          "type": "string"
        },
        "contexts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceID",
              "observedAt",
              "expiresAt",
              "rows"
            ],
            "properties": {
              "sourceID": {
                "enum": [
                  "timetable",
                  "unified-timetable",
                  "journey-planner"
                ]
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "sourceSHA256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "publication": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "sha256",
                  "timezone",
                  "operatingStartDate",
                  "operatingEndDate",
                  "holidayCoverageStart",
                  "holidayCoverageEnd",
                  "nonOperationBankHolidays"
                ],
                "properties": {
                  "url": {
                    "const": "https://tfl.gov.uk/tfl/syndication/feeds/journey-planner-timetables.zip"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "timezone": {
                    "const": "Europe/London"
                  },
                  "operatingStartDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                  },
                  "operatingEndDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                  },
                  "holidayCoverageStart": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                  },
                  "holidayCoverageEnd": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                  },
                  "nonOperationBankHolidays": {
                    "const": true
                  }
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "destinationID",
                    "destination",
                    "departure",
                    "routeStationIDs"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "destinationID": {
                      "type": "string"
                    },
                    "destination": {
                      "type": "string"
                    },
                    "departure": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "via": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 120
                    },
                    "providerDirection": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "routeStationIDs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 200,
                      "items": {
                        "type": "string"
                      }
                    },
                    "serviceDay": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                    },
                    "profileName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "profileSHA256": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "weekdays": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      }
                    },
                    "serviceMinute": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2879
                    },
                    "isBankHoliday": {
                      "const": false
                    },
                    "originatingServiceDateRanges": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "startDate",
                          "endDate"
                        ],
                        "properties": {
                          "startDate": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "endDate": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        }
                      },
                      "description": "Inclusive original service-day eligibility intersected with weekdays and publication bounds. Ordered/disjoint valid civil dates and the originating day are enforced by the runtime/seed consumer; absence preserves legacy qualification."
                    },
                    "publicationDirection": {
                      "enum": [
                        "inbound",
                        "outbound"
                      ]
                    }
                  }
                }
              },
              "publicationProofIdentity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "publicationSHA256",
                  "proofRevision",
                  "proofBodySHA256"
                ],
                "properties": {
                  "publicationSHA256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "proofRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "proofBodySHA256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "independentPublicationObservedAt": {
                "type": "string",
                "format": "date-time"
              },
              "publicationDirections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inbound",
                    "outbound"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "sourceID": {
                      "enum": [
                        "timetable",
                        "unified-timetable"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "publication"
                  ],
                  "properties": {
                    "rows": {
                      "items": {
                        "required": [
                          "serviceDay",
                          "profileName",
                          "profileSHA256",
                          "weekdays",
                          "serviceMinute",
                          "isBankHoliday"
                        ]
                      }
                    }
                  }
                },
                "else": {
                  "required": [
                    "sourceSHA256"
                  ],
                  "not": {
                    "required": [
                      "publication"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "publicationProofIdentity"
                  ]
                },
                "then": {
                  "properties": {
                    "sourceID": {
                      "enum": [
                        "timetable",
                        "unified-timetable"
                      ]
                    }
                  }
                }
              }
            ],
            "dependentRequired": {
              "publicationProofIdentity": [
                "independentPublicationObservedAt"
              ],
              "independentPublicationObservedAt": [
                "publicationProofIdentity"
              ],
              "publicationDirections": [
                "publicationProofIdentity",
                "independentPublicationObservedAt"
              ]
            }
          }
        },
        "closureEvidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stationID",
              "lineID",
              "sourceScope",
              "closed",
              "observedAt",
              "expiresAt"
            ],
            "properties": {
              "stationID": {
                "type": "string"
              },
              "lineID": {
                "type": "string"
              },
              "sourceScope": {
                "enum": [
                  "lineStatus",
                  "stationDisruptions"
                ]
              },
              "closed": {
                "type": "boolean"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "validFrom": {
                "type": "string",
                "format": "date-time"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time"
              },
              "closureWindows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "validFrom",
                    "validUntil"
                  ],
                  "properties": {
                    "validFrom": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "validUntil": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "plannedUnavailable": {
                "type": "boolean"
              },
              "scheduledClockOnly": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "closed": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "validFrom",
                    "validUntil"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "scheduledClockOnly"
                  ],
                  "properties": {
                    "scheduledClockOnly": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "validFrom",
                    "validUntil"
                  ],
                  "properties": {
                    "closed": {
                      "const": false
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "description": "At most24KiB original client-qualified scheduled context. Identity HEAD is corroboration only; no original dates/expiry are renewed."
    },
    "timetablePublicationAuthorityVersion": {
      "type": "integer",
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "selectionMode"
        ],
        "properties": {
          "selectionMode": {
            "const": "platform"
          }
        }
      },
      "then": {
        "required": [
          "platformID"
        ]
      }
    },
    {
      "if": {
        "required": [
          "timetablePublicationAuthorityVersion"
        ]
      },
      "then": {
        "required": [
          "contentStateContract",
          "plannedPresentationVersion"
        ]
      }
    },
    {
      "if": {
        "required": [
          "plannedContextSeed"
        ],
        "properties": {
          "plannedContextSeed": {
            "properties": {
              "contexts": {
                "contains": {
                  "required": [
                    "publicationProofIdentity"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "timetablePublicationAuthorityVersion",
          "plannedPresentationVersion"
        ]
      }
    }
  ]
}
