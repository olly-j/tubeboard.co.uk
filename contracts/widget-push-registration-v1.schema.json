{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tubeboard.co.uk/contracts/widget-push-registration-v1.schema.json",
  "title": "Widget push token routing v1",
  "description": "PUT or DELETE /api/widgets/token. Maximum encoded body 32768 bytes. APNs environment is independent of StoreKit environment. Purchase JWS is verified then discarded; it is never persisted. No installation, station, location, configuration or history fields.",
  "oneOf": [{ "$ref": "#/$defs/put" }, { "$ref": "#/$defs/delete" }],
  "$defs": {
    "token": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){1,256}$" },
    "environment": { "enum": ["sandbox", "production"] },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "put": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "token", "environment", "kinds", "revision", "transactionJWS"],
      "properties": {
        "schemaVersion": { "const": 1 }, "token": { "$ref": "#/$defs/token" },
        "environment": { "$ref": "#/$defs/environment" }, "revision": { "$ref": "#/$defs/revision" },
        "kinds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["TubeBoardFavouriteWidget", "TubeBoardLineStatusWidget", "TubeBoardPlatformWidget"] } },
        "transactionJWS": { "type": "string", "minLength": 1, "maxLength": 24576 }
      }
    },
    "delete": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "token", "environment", "revision"],
      "properties": {
        "schemaVersion": { "const": 1 }, "token": { "$ref": "#/$defs/token" },
        "environment": { "$ref": "#/$defs/environment" }, "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "putAcknowledgement": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "revision", "expiresAt"],
      "properties": { "schemaVersion": { "const": 1 }, "revision": { "$ref": "#/$defs/revision" }, "expiresAt": { "type": "string", "format": "date-time" } }
    },
    "deleteAcknowledgement": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "revision", "deleted"],
      "properties": { "schemaVersion": { "const": 1 }, "revision": { "$ref": "#/$defs/revision" }, "deleted": { "const": true } }
    }
  }
}
