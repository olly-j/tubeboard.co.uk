# Web service
PORT=4173
SITE_DIR=.

# Live Activity worker
LIVE_ACTIVITY_WORKER_ENABLED=true
LIVE_ACTIVITY_WORKER_INTERVAL_MS=90000
LIVE_ACTIVITY_DATA_FILE=data/live-activities.json
LIVE_ACTIVITY_MAX_ACTIVE_HOURS=8
LIVE_ACTIVITY_RETENTION_HOURS=24
LIVE_ACTIVITY_PAUSE_GRACE_MINUTES=10

# TfL Open Data. Optional, but recommended for production rate limits.
TFL_APP_KEY=

# APNs Live Activity push auth.
# Use either APNS_AUTH_KEY_PATH or APNS_AUTH_KEY.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=OllyJ.My-Train-Times

# Premium disruption alerts. Generate a private 32-byte key as 64 hex
# characters or base64. Never reuse or commit a production value.
DISRUPTION_ALERT_WORKER_ENABLED=false
DISRUPTION_ALERT_WORKER_INTERVAL_MS=60000
DISRUPTION_ALERT_DATA_FILE=data/disruption-alerts.json
DISRUPTION_ALERT_INACTIVITY_DAYS=90
DISRUPTION_ALERT_ENCRYPTION_KEY=
APP_STORE_APP_ID=6779771046
